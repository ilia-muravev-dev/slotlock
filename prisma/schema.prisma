// slotlock — see docs/adr for the reasoning behind the shape.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ResourceKind {
  ROOM
  DESK_POOL
}

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum IdempotencyStatus {
  IN_FLIGHT
  DONE
}

enum PaymentEventOutcome {
  APPLIED
  STALE
  DUPLICATE
  ORPHANED
  IGNORED
  UNKNOWN
}

/// A bookable thing: a meeting room (exclusive) or a pool of hot desks (capacity N).
model Resource {
  id         String       @id
  kind       ResourceKind
  name       String
  capacity   Int
  priceCents Int
  /// Bumped by the optimistic strategy on every successful reservation.
  version    Int          @default(0)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  bookings   Booking[]

  @@map("resources")
}

model Booking {
  id                 String        @id @default(uuid())
  resourceId         String
  resource           Resource      @relation(fields: [resourceId], references: [id])
  userId             String
  startsAt           DateTime      @db.Timestamptz(3)
  endsAt             DateTime      @db.Timestamptz(3)
  /// Denormalised from the resource kind so the exclusion constraint can filter on it.
  exclusive          Boolean
  status             BookingStatus @default(HELD)
  holdExpiresAt      DateTime?     @db.Timestamptz(3)
  amountCents        Int           @default(0)
  paymentId          String?       @unique
  /// Provider timestamp of the last payment event applied; older events are stale.
  paymentLastEventAt DateTime?     @db.Timestamptz(3)
  version            Int           @default(0)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  @@index([resourceId, startsAt, endsAt])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

/// One row per Idempotency-Key: in flight while the request runs, then the stored response.
model IdempotencyKey {
  key            String            @id
  userId         String
  requestHash    String
  status         IdempotencyStatus @default(IN_FLIGHT)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime          @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Every payment webhook received, by provider event id; the outcome records what was done with it.
model PaymentEvent {
  id                String              @id
  paymentId         String?
  type              String
  providerCreatedAt DateTime            @db.Timestamptz(3)
  receivedAt        DateTime            @default(now()) @db.Timestamptz(3)
  outcome           PaymentEventOutcome

  @@index([paymentId])
  @@map("payment_events")
}

/// Domain events written in the same transaction as the change they describe.
model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Idempotent consumers: a job key is processed at most once.
model ProcessedJob {
  key         String   @id
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("processed_jobs")
}

/// The in-process PSP's intents, in the database so the API and the worker see the same ones.
model FakePaymentIntent {
  id          String   @id
  bookingId   String
  amountCents Int
  status      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@map("fake_payment_intents")
}
