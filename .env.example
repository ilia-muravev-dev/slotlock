# Copy to .env (gitignored).
DATABASE_URL=postgresql://slotlock:slotlock@localhost:5432/slotlock
SHADOW_DATABASE_URL=postgresql://slotlock:slotlock@localhost:5432/slotlock_shadow
REDIS_URL=redis://localhost:6379/0
PORT=3000
LOG_LEVEL=info

# advisory | for_update | optimistic | serializable | exclusion — or naive, the control that double-books (refused in production)
BOOKING_STRATEGY=advisory
HOLD_TTL_SECONDS=600

# Payments: set the Stripe test keys to use Stripe; leave them empty for the in-repo fake PSP.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_slotlock_dev
