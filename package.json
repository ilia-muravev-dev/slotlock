{
  "name": "slotlock",
  "version": "0.1.0",
  "private": true,
  "description": "A reservation API that cannot double-book: five ways to serialise a booking, measured under load.",
  "license": "MIT",
  "author": "Ilia Muravev <ilia.muravev.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilia-muravev-dev/slotlock.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration test/property",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "^6.3.6",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
